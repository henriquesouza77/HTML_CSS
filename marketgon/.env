# Copie este arquivo para ".env" e ajuste os valores conforme seu XAMPP

# --- Servidor ---
PORT=3000

# --- Banco de dados (MySQL/MariaDB do XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mercearia_gon

# --- Autenticação ---
# Gere uma string aleatória forte para produção
JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria
JWT_EXPIRES_IN=8h

# --- Usuário administrador inicial (informativo) ---
# O usuário já é criado pelo database.sql com senha em hash bcrypt.
ADMIN_EMAIL=henriqueren.gustavoo@gmail.com
